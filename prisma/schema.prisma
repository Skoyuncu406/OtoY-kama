generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// YÖNETİCİLER

model AdminUser {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// KATEGORİLER

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  image    String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ÜRÜNLER

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  details      String?
  price        Decimal  @db.Decimal(10, 2)
  salePrice    Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  isNew        Boolean  @default(false)
  isBestSeller Boolean  @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  favorites  Favorite[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// ÜRÜN GÖRSELLERİ

model ProductImage {
  id       String  @id @default(cuid())
  url      String
  publicId String?
  order    Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

// MÜŞTERİLER

model Customer {
  id             String  @id @default(cuid())
  username       String  @unique
  email          String  @unique
  passwordHash   String
  isActive       Boolean @default(true)
  sessionVersion Int     @default(0)

  favorites Favorite[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MÜŞTERİ FAVORİLERİ

model Favorite {
  id String @id @default(cuid())

  customerId String
  productId  String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

// ÖDEME YÖNTEMLERİ

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE_PAYMENT
}

// ÖDEME DURUMLARI

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// SİPARİŞ DURUMLARI

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

// SİPARİŞ İPTAL TALEBİ DURUMLARI

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// SİPARİŞLER

model Order {
  id             String  @id @default(cuid())
  orderNumber    String  @unique
  idempotencyKey String? @unique

  // Benzersiz, tahmin edilmesi zor sipariş takip kodu.
  // Kod sipariş oluşturma API'sinde üretilecek.
  // Mevcut siparişler için sonradan doldurulacak.
  trackingCode String? @unique

  // Müşteri ilişkisi:
  // Üye siparişinde customerId dolu,
  // misafir siparişinde null olacak.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Teslimat bilgileri
  fullName   String
  email      String
  phone      String
  city       String
  district   String
  address    String
  postalCode String?
  orderNote  String?

  // Sipariş tutarları
  subtotal    Decimal @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @db.Decimal(10, 2)
  paymentFee  Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // Sipariş ve ödeme durumları
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Online ödeme sağlayıcısı bilgileri
  paymentProvider      String?
  paymentTransactionId String?
  paymentReference     String?

  // Kargo takip bilgileri
  shippingCompany String?
  trackingNumber  String?
  trackingUrl     String?

  // Tarihler
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  // Sipariş ürünleri
  items OrderItem[]

  // İptal talebi - bire bir ilişki
  cancellationRequest CancellationRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// SİPARİŞ KALEMLERİ

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Sipariş anındaki ürün bilgileri
  productName  String
  productImage String?
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  totalPrice   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// SİPARİŞ İPTAL TALEPLERİ

model CancellationRequest {
  id String @id @default(cuid())

  // Her sipariş için yalnızca bir iptal talebi
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Müşterinin iptal gerekçesi
  reason String

  // Talep durumu
  status CancellationRequestStatus @default(PENDING)

  // Yönetici değerlendirmesi
  adminNote String?

  // Değerlendirme tarihi
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
